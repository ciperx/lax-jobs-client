{
  "name": "@godman-protocols/lax-jobs-client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for LAX jobs: list, read and submit.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:live": "LAX_LIVE=1 node --test tests/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
